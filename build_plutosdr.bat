@echo off
setlocal EnableDelayedExpansion

echo ============================================================
echo  CyberEther - PlutoSDR Module Builder
echo ============================================================
echo.

set "PROJECT_ROOT=%~dp0"
set "BUILD_DIR=%PROJECT_ROOT%build"
set "MODULE_DIR=%PROJECT_ROOT%lib\SoapySDR\modules0.8"
set "SOAPY_CMAKE_DIR=%BUILD_DIR%\cmake"
set "PLUTOSDR_SRC=%PROJECT_ROOT%tools\SoapyPlutoSDR"
set "SOAPYSDR_INC=%PROJECT_ROOT%subprojects\SoapySDR-soapy-sdr-0.8.1\include"
set "SOAPYSDR_LIB=%BUILD_DIR%\subprojects\SoapySDR-soapy-sdr-0.8.1\SoapySDR.lib"

REM ---- Check that jetstream.dll was built ----
if not exist "%SOAPYSDR_LIB%" (
    echo  ERROR: SoapySDR.lib not found. Please build CyberEther first:
    echo    build_and_run.bat
    echo.
    pause
    exit /b 1
)

REM ---- Find libiio ----
echo [1/6] Looking for libiio installation...
set "LIBIIO_PREFIX="
for %%P in (
    "C:\Program Files\libiio"
    "C:\Program Files (x86)\libiio"
    "C:\Program Files\Analog Devices\libiio"
    "C:\libiio"
) do (
    if exist "%%~P\include\iio.h" (
        set "LIBIIO_PREFIX=%%~P"
        goto :found_libiio
    )
)

echo.
echo  ERROR: libiio not found!
echo.
echo  Please download and install libiio for Windows from:
echo    https://github.com/analogdevicesinc/libiio/releases
echo.
echo  Look for the Windows .exe installer in the latest release assets.
echo  After installation, re-run this script.
echo.
pause
exit /b 1

:found_libiio
echo  Found libiio at: !LIBIIO_PREFIX!

REM Find the correct lib filename
set "LIBIIO_LIB=!LIBIIO_PREFIX!\lib\libiio.lib"
if not exist "!LIBIIO_LIB!" set "LIBIIO_LIB=!LIBIIO_PREFIX!\lib\iio.lib"
if not exist "!LIBIIO_LIB!" (
    echo  ERROR: Cannot find libiio.lib or iio.lib in !LIBIIO_PREFIX!\lib\
    echo  Contents of lib dir:
    dir "!LIBIIO_PREFIX!\lib\" /b 2>nul
    pause
    exit /b 1
)

REM Find libiio.dll
set "LIBIIO_DLL=!LIBIIO_PREFIX!\bin\libiio.dll"
if not exist "!LIBIIO_DLL!" set "LIBIIO_DLL=!LIBIIO_PREFIX!\libiio.dll"
echo.

REM ---- Find cmake ----
echo [2/6] Finding cmake...
set "CMAKE_EXE="
for %%P in (
    "C:\Program Files (x86)\Microsoft Visual Studio\2022\BuildTools\Common7\IDE\CommonExtensions\Microsoft\CMake\CMake\bin\cmake.exe"
    "C:\Program Files\Microsoft Visual Studio\2022\Community\Common7\IDE\CommonExtensions\Microsoft\CMake\CMake\bin\cmake.exe"
    "C:\Program Files\CMake\bin\cmake.exe"
) do (
    if exist %%P (
        set "CMAKE_EXE=%%P"
        goto :found_cmake
    )
)
echo  ERROR: cmake not found. Install Visual Studio Build Tools with cmake component.
pause
exit /b 1

:found_cmake
echo  Found cmake: !CMAKE_EXE!
echo.

REM ---- Generate SoapySDR cmake config ----
echo [3/6] Generating SoapySDR cmake config...
mkdir "%SOAPY_CMAKE_DIR%" 2>nul

REM Use forward slashes for cmake paths
set "SOAPYSDR_INC_FWD=%SOAPYSDR_INC:\=/%"
set "SOAPYSDR_LIB_FWD=%SOAPYSDR_LIB:\=/%"

(
echo # Auto-generated by build_plutosdr.bat
echo set^(SoapySDR_FOUND TRUE^)
echo set^(SOAPY_SDR_VERSION "0.8.1"^)
echo set^(SOAPY_SDR_ABI_VERSION "0.8"^)
echo set^(SOAPY_SDR_INCLUDE_DIRS "%SOAPYSDR_INC_FWD%"^)
echo set^(SOAPY_SDR_LIBRARIES "%SOAPYSDR_LIB_FWD%"^)
echo include^("${CMAKE_CURRENT_LIST_DIR}/SoapySDRUtil.cmake"^)
) > "%SOAPY_CMAKE_DIR%\SoapySDRConfig.cmake"

(
echo macro^(SOAPY_SDR_MODULE_UTIL^)
echo     cmake_parse_arguments^(SDR_MODULE "" "TARGET;DESTINATION" "SOURCES;LIBRARIES;COMPILE_FLAGS" ${ARGN}^)
echo     add_library^(${SDR_MODULE_TARGET} MODULE ${SDR_MODULE_SOURCES}^)
echo     target_include_directories^(${SDR_MODULE_TARGET} PRIVATE ${SOAPY_SDR_INCLUDE_DIRS}^)
echo     target_link_libraries^(${SDR_MODULE_TARGET} PRIVATE ${SOAPY_SDR_LIBRARIES} ${SDR_MODULE_LIBRARIES}^)
echo     if^(SDR_MODULE_COMPILE_FLAGS^)
echo         target_compile_options^(${SDR_MODULE_TARGET} PRIVATE ${SDR_MODULE_COMPILE_FLAGS}^)
echo     endif^(^)
echo     set_target_properties^(${SDR_MODULE_TARGET} PROPERTIES PREFIX "" SUFFIX ".dll"^)
echo endmacro^(^)
) > "%SOAPY_CMAKE_DIR%\SoapySDRUtil.cmake"

echo  Generated cmake config in: %SOAPY_CMAKE_DIR%
echo.

REM ---- Clone SoapyPlutoSDR ----
echo [4/6] Getting SoapyPlutoSDR source...
if not exist "%PLUTOSDR_SRC%\CMakeLists.txt" (
    echo  Cloning SoapyPlutoSDR...
    mkdir "%PROJECT_ROOT%tools" 2>nul
    git clone --depth 1 https://github.com/pothosware/SoapyPlutoSDR.git "%PLUTOSDR_SRC%"
    if errorlevel 1 (
        echo  ERROR: Failed to clone SoapyPlutoSDR
        pause
        exit /b 1
    )
) else (
    echo  SoapyPlutoSDR source already present.
)
echo.

REM ---- Build SoapyPlutoSDR ----
echo [5/6] Building SoapyPlutoSDR...
set "PLUTOSDR_BUILD=%PLUTOSDR_SRC%\build_msvc"
mkdir "%PLUTOSDR_BUILD%" 2>nul

call "C:\Program Files (x86)\Microsoft Visual Studio\2022\BuildTools\Common7\Tools\VsDevCmd.bat" -arch=x64 >nul 2>&1

set "LIBIIO_INC_FWD=!LIBIIO_PREFIX:\=/!/include"
set "LIBIIO_LIB_FWD=!LIBIIO_LIB:\=/!"

"!CMAKE_EXE!" -S "%PLUTOSDR_SRC%" -B "%PLUTOSDR_BUILD%" ^
    -G "Visual Studio 17 2022" -A x64 ^
    -DSoapySDR_DIR="%SOAPY_CMAKE_DIR%" ^
    -DLibIIO_INCLUDE_DIR="!LIBIIO_INC_FWD!" ^
    -DLibIIO_LIBRARY="!LIBIIO_LIB_FWD!" ^
    -DCMAKE_BUILD_TYPE=Release

if errorlevel 1 (
    echo.
    echo  ERROR: cmake configuration failed
    pause
    exit /b 1
)

"!CMAKE_EXE!" --build "%PLUTOSDR_BUILD%" --config Release
if errorlevel 1 (
    echo.
    echo  ERROR: Build failed
    pause
    exit /b 1
)
echo.

REM ---- Install DLL ----
echo [6/6] Installing modules...
mkdir "%MODULE_DIR%" 2>nul

set "DLL_SRC=%PLUTOSDR_BUILD%\Release\PlutoSDRSupport.dll"
if not exist "!DLL_SRC!" set "DLL_SRC=%PLUTOSDR_BUILD%\PlutoSDRSupport.dll"

if not exist "!DLL_SRC!" (
    echo  ERROR: Built DLL not found. Build dir contents:
    dir "%PLUTOSDR_BUILD%" /b /s *.dll 2>nul
    pause
    exit /b 1
)

copy /Y "!DLL_SRC!" "%MODULE_DIR%\SoapyPlutoSDR.dll"
echo  Installed: %MODULE_DIR%\SoapyPlutoSDR.dll

REM Copy libiio.dll and dependencies to build/ (needed at runtime)
if exist "!LIBIIO_DLL!" (
    copy /Y "!LIBIIO_DLL!" "%BUILD_DIR%\"
    echo  Copied libiio.dll
) else (
    echo  WARNING: libiio.dll not found at !LIBIIO_DLL!
    echo  You may need to copy libiio.dll manually to: %BUILD_DIR%
)
REM Copy charset.dll (required by iconv -> libxml2 -> libiio dependency chain)
set "CHARSET_DLL=!LIBIIO_PREFIX!\bin\charset.dll"
if not exist "!CHARSET_DLL!" set "CHARSET_DLL=!LIBIIO_PREFIX!\charset.dll"
if exist "!CHARSET_DLL!" (
    copy /Y "!CHARSET_DLL!" "%BUILD_DIR%\"
    echo  Copied charset.dll
) else (
    echo  WARNING: charset.dll not found - copy it manually to: %BUILD_DIR%
)

echo.
echo ============================================================
echo  SUCCESS! PlutoSDR module is ready.
echo.
echo  Next steps:
echo   1. Connect your ADALM-PLUTO via USB
echo   2. Install USB driver: run Zadig, select PlutoSDR, install WinUSB
echo   3. Run CyberEther: build_and_run.bat
echo   4. Add a "Soapy" block - PlutoSDR will appear in device list
echo ============================================================
pause
